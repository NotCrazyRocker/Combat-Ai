{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/combat-ai/observation-1.0.0.schema.json",
  "title": "Combat AI Minecraft Observation",
  "type": "object",
  "required": ["schema_version", "sequence", "client_tick_sequence", "server_tick", "server_tick_available", "level_game_time", "tick_source", "authority", "provenance", "player", "opponent", "derived", "events", "world", "transport"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "client_tick_sequence": {"type": "integer", "minimum": 1},
    "server_tick": {"type": ["integer", "null"]},
    "server_tick_available": {"type": "boolean"},
    "captured_at_epoch_ms": {"type": "integer"},
    "level_game_time": {"type": "integer"},
    "tick_source": {"const": "fabric_client_end_tick"},
    "authority": {"const": "client_observed_world_state"},
    "provenance": {"type": "object"},
    "player": {"$ref": "#/$defs/entity"},
    "opponent": {"oneOf": [{"$ref": "#/$defs/entity"}, {"type": "null"}]},
    "derived": {"type": "object"},
    "events": {"type": "object"},
    "world": {"type": "object"},
    "transport": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"server_tick_available": {"const": true}}, "required": ["server_tick_available"]},
      "then": {"properties": {"server_tick": {"type": "integer", "minimum": 0}}},
      "else": {"properties": {"server_tick": {"type": "null"}}}
    }
  ],
  "$defs": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}},
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["uuid", "entity_type", "position", "velocity", "yaw_degrees", "pitch_degrees", "health", "absorption", "armor_points", "equipment", "status_effects", "movement"],
      "properties": {
        "uuid": {"type": "string"},
        "name": {"type": "string"},
        "entity_type": {"type": "string"},
        "position": {"$ref": "#/$defs/vector3"},
        "velocity": {"$ref": "#/$defs/vector3"},
        "yaw_degrees": {"type": "number"},
        "pitch_degrees": {"type": "number"},
        "health": {"type": "number"},
        "max_health": {"type": "number"},
        "absorption": {"type": "number"},
        "armor_points": {"type": "integer"},
        "hurt_time": {"type": "integer"},
        "damage_observed_this_tick": {"type": "number"},
        "attack_cooldown_scale": {"type": "number"},
        "equipment": {"type": "object"},
        "status_effects": {"type": "array"},
        "movement": {"type": "object"}
      }
    }
  }
}
